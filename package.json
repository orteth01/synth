{
  "name": "synth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worklets": "node scripts/build-worklets.mjs",
    "watch:worklets": "node scripts/build-worklets.mjs --watch",
    "dev": "pnpm build:worklets && concurrently -n vite,worklet -c blue,magenta \"vite\" \"pnpm watch:worklets\"",
    "build": "pnpm build:worklets && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/audioworklet": "^0.0.60",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "fft.js": "^4.0.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
